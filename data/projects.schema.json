{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-project-coach.local/schemas/projects.schema.json",
  "title": "AI Project Coach Project Catalog",
  "description": "Validation rules for the curated project catalog.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/project"
  },
  "$defs": {
    "normalizedSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "direction",
        "description",
        "skills",
        "difficulty",
        "estimated_hours",
        "prerequisites",
        "deliverables",
        "phases",
        "references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(fe|be|fs|da|ml|ac)-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "direction": {
          "type": "string",
          "enum": [
            "frontend",
            "backend",
            "full-stack",
            "data-analysis",
            "machine-learning",
            "automation-cloud"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "skills": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalizedSlug"
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "estimated_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/normalizedSlug"
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "phases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "percentage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "percentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "url",
        "use_for"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "type": {
          "type": "string",
          "enum": [
            "reference-implementation",
            "official-documentation",
            "dataset",
            "tutorial"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "use_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          }
        }
      }
    }
  }
}
